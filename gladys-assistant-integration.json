  "scene_actions": [
    {
      "key": "refresh_car",
      "label": {
        "en": "Read a Polestar now",
        "fr": "Lire une Polestar maintenant",
        "de": "Polestar jetzt auslesen",
        "es": "Leer un Polestar ahora"
      },
      "description": {
        "en": "Reads the car from the Polestar cloud and gives its values to the next actions.",
        "fr": "Lit la voiture dans le cloud Polestar et donne ses valeurs aux actions suivantes.",
        "de": "Liest das Auto aus der Polestar-Cloud und gibt seine Werte an die nächsten Aktionen.",
        "es": "Lee el coche en la nube de Polestar y pasa sus valores a las acciones siguientes."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "car",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Car",
            "fr": "Voiture",
            "de": "Auto",
            "es": "Coche"
          },
          "required": true
        }
      ],
